          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TOP 25\n  o.OrderDateUtc AS Tid,\n  o.OrderId AS [Order],\n  ISNULL(w.Name, CONCAT('Lager ', o.WarehouseId)) AS Lager,\n  (SELECT SUM(i.Quantity) FROM sitoo.OrderItems i WHERE i.OrderId = o.OrderId AND i.Sku IS NOT NULL) AS Artiklar,\n  (SELECT STRING_AGG(p.Name, ', ') FROM sitoo.OrderPayments p WHERE p.OrderId = o.OrderId) AS Betalning,\n  o.MoneyTotalGrossAll AS [Belopp inkl. moms]\nFROM sitoo.Orders o\nLEFT JOIN sitoo.Warehouses w ON w.SiteId = o.EshopId AND w.WarehouseId = o.WarehouseId\nORDER BY o.OrderId DESC"
        }
