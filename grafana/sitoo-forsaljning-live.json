    {
      "id": 5,
      "type": "stat",
      "title": "Snittkvitto (inkl. moms)",
      "datasource": {
        "type": "mssql",
        "uid": "${DS_SITOO}"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 4,
