    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Topp 10 produkter",
      "datasource": {
        "type": "mssql",
        "uid": "${DS_SITOO}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 10,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TOP 10 ISNULL(i.ProductName, i.Sku) AS Produkt, SUM(i.MoneyItemTotalNet) AS [Försäljning]\nFROM sitoo.OrderItems i JOIN sitoo.Orders o ON o.OrderId = i.OrderId\nWHERE o.OrderDateUtc >= DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2)) AND o.OrderDateUtc < DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2)) AND i.Sku IS NOT NULL\nGROUP BY ISNULL(i.ProductName, i.Sku)\nORDER BY 2 DESC"
        }
      ],
      "description": "Försäljning exkl. moms per produkt i vald period.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencySEK",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "sizing": "auto"
      }
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Betalsätt",
      "datasource": {
        "type": "mssql",
        "uid": "${DS_SITOO}"
      },
      "gridPos": {
        "x": 10,
        "y": 15,
        "w": 7,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT p.Name AS Betalsatt, SUM(p.MoneyAmount) AS Belopp\nFROM sitoo.OrderPayments p JOIN sitoo.Orders o ON o.OrderId = p.OrderId\nWHERE o.OrderDateUtc >= DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2)) AND o.OrderDateUtc < DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2))\nGROUP BY p.Name\nHAVING SUM(p.MoneyAmount) > 0\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencySEK",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
