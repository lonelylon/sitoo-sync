    {
      "id": 7,
      "type": "timeseries",
      "title": "Ackumulerad försäljning – nu mot förra veckan",
      "datasource": {
        "type": "mssql",
        "uid": "${DS_SITOO}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DATEADD(HOUR, DATEDIFF(HOUR, 0, o.OrderDateUtc), 0) AS time,\n       SUM(SUM(o.MoneyFinalNet)) OVER (ORDER BY DATEADD(HOUR, DATEDIFF(HOUR, 0, o.OrderDateUtc), 0)) AS [Nu]\nFROM sitoo.Orders o\nWHERE o.OrderDateUtc >= DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2)) AND o.OrderDateUtc < DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2))\nGROUP BY DATEADD(HOUR, DATEDIFF(HOUR, 0, o.OrderDateUtc), 0)\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DATEADD(HOUR, DATEDIFF(HOUR, 0, DATEADD(DAY, 7, o.OrderDateUtc)), 0) AS time,\n       SUM(SUM(o.MoneyFinalNet)) OVER (ORDER BY DATEADD(HOUR, DATEDIFF(HOUR, 0, DATEADD(DAY, 7, o.OrderDateUtc)), 0)) AS [Förra veckan]\nFROM sitoo.Orders o\nWHERE o.OrderDateUtc >= DATEADD(DAY, -7, DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2))) AND o.OrderDateUtc < DATEADD(DAY, -7, DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2)))\nGROUP BY DATEADD(HOUR, DATEDIFF(HOUR, 0, DATEADD(DAY, 7, o.OrderDateUtc)), 0)\nORDER BY 1"
        }
      ],
      "description": "Försäljning exkl. moms, ackumulerad per timme. Förra veckans kurva är flyttad en vecka framåt så att de går att jämföra.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencySEK",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Nu"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Förra veckan"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Försäljning per timme",
      "datasource": {
        "type": "mssql",
        "uid": "${DS_SITOO}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DATEADD(HOUR, DATEDIFF(HOUR, 0, o.OrderDateUtc), 0) AS time, SUM(o.MoneyFinalNet) AS [Nu]\nFROM sitoo.Orders o WHERE o.OrderDateUtc >= DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2)) AND o.OrderDateUtc < DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2))\nGROUP BY DATEADD(HOUR, DATEDIFF(HOUR, 0, o.OrderDateUtc), 0) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DATEADD(HOUR, DATEDIFF(HOUR, 0, DATEADD(DAY, 7, o.OrderDateUtc)), 0) AS time, SUM(o.MoneyFinalNet) AS [Förra veckan]\nFROM sitoo.Orders o WHERE o.OrderDateUtc >= DATEADD(DAY, -7, DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2))) AND o.OrderDateUtc < DATEADD(DAY, -7, DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2)))\nGROUP BY DATEADD(HOUR, DATEDIFF(HOUR, 0, DATEADD(DAY, 7, o.OrderDateUtc)), 0) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
