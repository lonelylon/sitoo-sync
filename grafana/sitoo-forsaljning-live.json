            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ISNULL(w.Name, CONCAT('Lager ', o.WarehouseId)) AS Lager, SUM(o.MoneyFinalNet) AS [Försäljning]\nFROM sitoo.Orders o\nLEFT JOIN sitoo.Warehouses w ON w.SiteId = o.EshopId AND w.WarehouseId = o.WarehouseId\nWHERE o.OrderDateUtc >= DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2)) AND o.OrderDateUtc < DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2))\nGROUP BY ISNULL(w.Name, CONCAT('Lager ', o.WarehouseId))\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencySEK",
          "decimals": 0,
