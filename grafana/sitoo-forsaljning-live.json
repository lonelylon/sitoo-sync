  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Försäljning (exkl. moms)",
      "datasource": {
        "type": "mssql",
        "uid": "${DS_SITOO}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ISNULL(SUM(o.MoneyFinalNet), 0) AS value FROM sitoo.Orders o WHERE o.OrderDateUtc >= DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2)) AND o.OrderDateUtc < DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2))"
        }
      ],
      "description": "Summa av ordrarnas belopp exkl. moms i vald period. Returer räknas av.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencySEK",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Samma tid förra veckan",
      "datasource": {
        "type": "mssql",
        "uid": "${DS_SITOO}"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ISNULL(SUM(o.MoneyFinalNet), 0) AS value FROM sitoo.Orders o WHERE o.OrderDateUtc >= DATEADD(DAY, -7, DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2))) AND o.OrderDateUtc < DATEADD(DAY, -7, DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2)))"
        }
      ],
      "description": "Samma period, en vecka tidigare.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencySEK",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
