      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT AVG(o.MoneyTotalGrossAll) AS value FROM sitoo.Orders o WHERE o.OrderDateUtc >= DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2)) AND o.OrderDateUtc < DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2)) AND o.MoneyTotalGrossAll > 0"
        }
