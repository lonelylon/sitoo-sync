      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Sålda artiklar",
      "datasource": {
        "type": "mssql",
        "uid": "${DS_SITOO}"
      },
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_SITOO}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ISNULL(SUM(i.Quantity), 0) AS value\nFROM sitoo.OrderItems i JOIN sitoo.Orders o ON o.OrderId = i.OrderId\nWHERE o.OrderDateUtc >= DATEADD(SECOND, $__unixEpochFrom(), CAST('19700101' AS datetime2)) AND o.OrderDateUtc < DATEADD(SECOND, $__unixEpochTo(), CAST('19700101' AS datetime2)) AND i.Sku IS NOT NULL"
