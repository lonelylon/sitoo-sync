# Valfritt: startvärden för inställningarna (webbgränssnittet är det vanliga sättet).
# Värden som sparas i webbgränssnittet har företräde.
# ---------- Sitoo ----------
# Finns i Sitoo Backoffice under Inställningar > Sitoo REST API.
# Bas-URL: allt fram till och med /v2 (t.ex. https://api.mysitoo.com/v2)
SITOO_BASE_URL=https://api.mysitoo.com/v2
SITOO_ACCOUNT_ID=
SITOO_API_ID=
SITOO_API_PASSWORD=
# En eller flera siter (eshopid), kommaseparerade
SITOO_SITE_IDS=1

# ---------- SQL Server ----------
# Alternativ A: QNAP:ens IP-adress och den port SQL Server-containern publicerar
# Alternativ B: SQL Server-containerns namn (kräver gemensamt nätverk, se docker-compose.yml)
MSSQL_SERVER=192.168.1.10
MSSQL_PORT=1433
MSSQL_DATABASE=SitooSync
MSSQL_USER=sitoosync
MSSQL_PASSWORD=
# Skapar databasen automatiskt om den saknas (kräver rättighet att skapa databaser)
MSSQL_CREATE_DATABASE=true

# ---------- Schema (minuter, ordrar i sekunder, 0 = avstängt) ----------
INTERVAL_STORES_MIN=60
INTERVAL_PRODUCTS_MIN=15
INTERVAL_PRODUCTS_DELETED_MIN=1440
INTERVAL_STOCK_MIN=15
INTERVAL_ORDERS_SEC=60
INTERVAL_ORDERS_REFRESH_MIN=360
INTERVAL_ZREPORTS_MIN=60
INTERVAL_USERS_MIN=360

# ---------- Övrigt ----------
# Uppdatera lagersaldo och hämta saknade produkter/personal/lager vid nya ordrar
ENRICH_ORDERS=true
# Hämta ordrar bakåt i tiden bara från detta datum vid första körningen (tomt = all historik)
ORDERS_FROM_DATE=
# Hur många dagar bakåt ordrar hämtas om för att fånga statusändringar
ORDERS_REFRESH_DAYS=3
# Antal poster per API-anrop
PAGE_SIZE=100
LOG_LEVEL=INFO
